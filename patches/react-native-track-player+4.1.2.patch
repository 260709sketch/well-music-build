+    }
+    
+    public func getArtist() -> String? {
+        artist
+    }
+    
+    public func getTitle() -> String? {
+        title
+    }
+    
+    public func getAlbumTitle() -> String? {
+        albumTitle
+    }
+    
+    public func getSourceType() -> SourceType {
+        sourceType
+    }
+
+    public func getArtwork(_ handler: @escaping (UIImage?) -> Void) {
